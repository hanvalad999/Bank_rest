{
  "info": {
    "name": "Bankcards API",
    "description": "Запросы для проверки API банковских карт. После логина токен сохраняется в переменную `token` и подставляется в запросы.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (новый пользователь)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.username) pm.collectionVariables.set('userToken', pm.collectionVariables.get('token') || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Регистрация. username 3-100 символов, password минимум 6."
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) pm.collectionVariables.set('adminToken', json.token);",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Логин админа. Укажите app.admin.username и app.admin.password из конфига (или переменные окружения). После запроса token сохраняется в коллекцию."
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) pm.collectionVariables.set('userToken', json.token);",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Логин обычного пользователя. После запроса token сохраняется в userToken."
          }
        }
      ]
    },
    {
      "name": "Users (ADMIN)",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/api/users",
            "description": "Создать пользователя. role: USER или ADMIN. Нужен JWT админа."
          }
        },
        {
          "name": "Get users (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?page=0&size=20&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "id,asc" }
              ]
            },
            "description": "Список пользователей с пагинацией."
          },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users?id=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{ "key": "id", "value": "2" }]
            },
            "description": "Удалить пользователя по id. Нужен JWT админа."
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Create card (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"cardNumber\": \"4111111111111111\",\n  \"expirationDate\": \"2028-12-31\",\n  \"initialBalance\": 1000.00\n}"
            },
            "url": "{{baseUrl}}/api/cards",
            "description": "Создать карту. cardNumber 12-19 символов. Нужен JWT админа. Сначала выполните Login (admin) и установите token."
          }
        },
        {
          "name": "Get all cards (ADMIN)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cards?page=0&size=20&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "id,asc" }
              ]
            },
            "description": "Все карты. Опционально: status=ACTIVE|BLOCKED|EXPIRED."
          }
        },
        {
          "name": "Get card by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cards/1",
            "description": "Карта по id. USER видит только свои карты, ADMIN — любую."
          }
        },
        {
          "name": "Get my cards (USER)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cards/my?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards", "my"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Карты текущего пользователя. Опционально: status=ACTIVE|BLOCKED|EXPIRED."
          }
        },
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cards/1/balance",
            "description": "Баланс карты по id."
          }
        },
        {
          "name": "Update card status (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BLOCKED\"\n}"
            },
            "url": "{{baseUrl}}/api/cards/1/status",
            "description": "Изменить статус карты. status: ACTIVE, BLOCKED, EXPIRED."
          }
        },
        {
          "name": "Request block (USER)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cards/1/block-request",
            "description": "Пользователь запрашивает блокировку своей карты."
          }
        },
        {
          "name": "Delete card (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cards/1",
            "description": "Удалить карту по id."
          }
        }
      ]
    },
    {
      "name": "Transfers (USER)",
      "item": [
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromCardId\": 1,\n  \"toCardId\": 2,\n  \"amount\": 50.00\n}"
            },
            "url": "{{baseUrl}}/api/transfers",
            "description": "Перевод с карты на карту. fromCardId должна принадлежать текущему пользователю. amount > 0."
          }
        }
      ]
    }
  ]
}
